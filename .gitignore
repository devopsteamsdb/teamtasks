# Ignore Flask instance folder (Contains SQLite database file)
/instance/
*.db
*.sqlite
*.sqlite3

# Ignore static files (Contains images)
/static/images/*

# Ignore uploads (User-uploaded avatars)
/uploads/

# Python cache & temporary files
__pycache__/
*.pyc
*.pyo
*.pyd
*.log

# Virtual environments
/venv/
/.venv/
/env/

# Node modules
/node_modules/

# Ignore backups
*.json
!package.json
!package-lock.json

# Ignore archives
*.tar
*.tar.gz
*.zip

# Environment variables & secrets
.env
.env.*
!.env.example

# OS generated files
.DS_Store
Thumbs.db
