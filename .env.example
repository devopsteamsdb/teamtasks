# ==========================================
# TeamTasks Environment Configuration
# ==========================================

# Application Settings
APP_NAME=TeamTasks
FLASK_APP=app.py
FLASK_DEBUG=0

# AI Provider ("local_openai" or "cloudflare")
AI_PROVIDER=local_openai

# Local / Air-Gapped OpenAI-Compatible Gateway (Ollama, vLLM, LocalAI)
OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_MODEL=llama3.3
OPENAI_API_KEY=

# Cloudflare Workers AI (Optional Cloud Alternative)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/meta/llama-3.1-8b-instruct
