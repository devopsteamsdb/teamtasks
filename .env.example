# ==========================================
# TeamTasks Environment Configuration
# ==========================================

# Application Settings
APP_NAME=TeamTasks
FLASK_APP=app.py
FLASK_DEBUG=0

# AI Provider ("local_openai" or "cloudflare")
AI_PROVIDER=local_openai

# Local / Air-Gapped OpenAI-Compatible Gateway (Ollama, vLLM, LocalAI)
OPENAI_API_BASE=http://localhost:11434/v1
OPENAI_MODEL=llama3.3
OPENAI_API_KEY=

# Cloudflare Workers AI (Optional Cloud Alternative)
# Recommended models: @cf/google/gemma-4-26b-a4b-it, @cf/qwen/qwen3.8-27b, @cf/meta/llama-3.3-70b-instruct-fp8-fast
# Frontier models (Paid plan): @cf/deepseek-ai/deepseek-v4.1-flash-1017, @cf/zai-org/glm-5.3
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_MODEL=@cf/google/gemma-4-26b-a4b-it

# MCP Server (Model Context Protocol for AI Agents)
# Optional API Key to secure remote HTTP/SSE MCP requests (/mcp). Leave empty for open local access.
MCP_API_KEY=
# Optional Remote TeamTasks URL when running mcp_server.py as a remote proxy (default: direct local DB)
TEAMTASKS_API_URL=
